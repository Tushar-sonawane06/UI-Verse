# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.webp binary
*.avif binary

# Build artifacts
dist/ -text
node_modules/ -text

# Ignore backup files (keep them out of Git tracking)
*.bak linguist-vendored

# GitHub specific
.gitattributes text eol=lf
.gitignore text eol=lf

# Shell scripts must be LF
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
